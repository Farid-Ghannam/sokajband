rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      // Anyone can submit a message (the public form on the site).
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'read', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.read == false
                    && request.resource.data.timestamp == request.time;

      // Only signed-in users (you / the band, via the admin page) can
      // read, update (mark as read), or delete messages.
      allow read, update, delete: if request.auth != null;
    }
  }
}
