rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /messages/{messageId} {
      // Anyone can submit a message (the public form on the site).
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'read', 'timestamp'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.read == false
                    && request.resource.data.timestamp == request.time;

      // Only the specific admin email(s) below can read, update (mark as
      // read), or delete messages — not just any signed-in Firebase user.
      // Add more emails to the list if more than one person needs access.
      allow read, update, delete: if request.auth != null
                    && request.auth.token.email in ['sokajwiki@gmail.com'];
    }
  }
}
